# Copy to .env and fill in. Never commit .env.

# Database (Supabase Postgres)
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require&reWriteBatchedInserts=true
DB_USERNAME=postgres
# Hosts without IPv6 (Render, Railway, Vercel...) must use the session pooler instead:
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&reWriteBatchedInserts=true
# DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Sign-in tokens (a long random string)
JWT_SECRET=

# Staff login at /admin (password: 12+ characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Payments (Stripe test or live keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for the payment webhook (Stripe dashboard > Webhooks, or `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Film data
TMDB_API_KEY=

# Chat assistant (Google AI Studio)
GEMINI_API_KEY=
# Optional: GEMINI_MODEL, GEMINI_FALLBACK_MODELS

# Websites allowed to call the API (comma-separated). Defaults to local development.
# CORS_ALLOWED_ORIGINS=https://cinebook.vercel.app

# Uploaded images (admin posters, snack photos, profile pictures). With both set,
# they go to a public Supabase Storage bucket (created automatically) and survive
# redeploys; without them they're saved in MovieBackend/uploads/.
# Use the secret key from Supabase > Project Settings > API Keys. Keep it private.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=cinebook-media
