# Copy to .env and fill in. Never commit .env.

# Database (Supabase Postgres)
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require&reWriteBatchedInserts=true
DB_USERNAME=postgres
DB_PASSWORD=

# Sign-in tokens (a long random string)
JWT_SECRET=

# Staff login at /admin (password: 12+ characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Payments (Stripe test or live keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Film data
TMDB_API_KEY=

# Chat assistant (Google AI Studio)
GEMINI_API_KEY=
# Optional: GEMINI_MODEL, GEMINI_FALLBACK_MODELS
